<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ANIeC APS - Associazione Nazionale</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Colore blu istituzionale basato sul tuo logo */
        .bg-aniec { background-color: #004a99; }
        .text-aniec { color: #004a99; }
    </style>
</head>
<body class="bg-gray-50 font-sans">

    <!-- Header / Navigazione -->
    <nav class="bg-white shadow-lg sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-center h-20">
                <div>
                    <img src="favicon.png" alt="Logo" class="h-12 inline mr-2">
                    <span class="font-bold text-xl text-aniec">ANIeC APS</span>
                </div>
                <div class="hidden md:flex space-x-8 text-gray-700 font-medium">
                    <a href="index.html" class="hover:text-aniec">Home</a>
                    <a href="chi-siamo.html" class="hover:text-aniec">Chi Siamo</a>
                    <a href="servizi.html" class="hover:text-aniec">Servizi</a>
                    <a href="contatti.html" class="hover:text-aniec">Contatti</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Sezione Hero -->
    <header class="bg-aniec text-white py-20 px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Benvenuti in ANIeC</h1>
        <p class="text-xl max-w-2xl mx-auto">Supporto e consulenza specialistica per il cittadino e le imprese.</p>
    </header>

    <!-- Sezione Servizi (Griglia) -->
    <main class="max-w-6xl mx-auto py-12 px-4">
        <h2 class="text-3xl font-bold text-center mb-12">I Nostri Servizi</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Servizio 1 -->
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-aniec">
                <h3 class="text-xl font-bold mb-3">Sovraindebitamento</h3>
                <p class="text-gray-600 mb-4">Gestione delle crisi e supporto legale per la ripartenza finanziaria.</p>
                <a href="sovraindebitamento.html" class="text-aniec font-semibold hover:underline">Scopri di più →</a>
            </div>

            <!-- Servizio 2 -->
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-aniec">
                <h3 class="text-xl font-bold mb-3">Consulenza Lavoro</h3>
                <p class="text-gray-600 mb-4">Assistenza completa per dipendenti e datori di lavoro.</p>
                <a href="lavoro.html" class="text-aniec font-semibold hover:underline">Scopri di più →</a>
            </div>

            <!-- Servizio 3 -->
            <div class="bg-white p-6 rounded-lg shadow-md border-t-4 border-aniec">
                <h3 class="text-xl font-bold mb-3">Assistenza Fiscale</h3>
                <p class="text-gray-600 mb-4">Supporto per dichiarazioni, tasse e agevolazioni fiscali.</p>
                <a href="fiscale.html" class="text-aniec font-semibold hover:underline">Scopri di più →</a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-8 mt-12">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <p>&copy; 2024 ANIeC APS - Tutti i diritti riservati.</p>
        </div>
    </footer>

</body>
</html>
